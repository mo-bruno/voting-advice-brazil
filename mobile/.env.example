# Valores públicos de build. Flutter não carrega este arquivo automaticamente.
# Passe com --dart-define=PUBLIC_APP_URL=https://fpolitico.com.br
# No GitHub Actions, configure a variável de repositório PUBLIC_APP_URL.
PUBLIC_APP_URL=https://fpolitico.com.br

# Acompanhamento real fica retido; false mostra o registro de interesse sem nome ou contato (pseudônimo).
# Passe com --dart-define=POLITICIAN_FOLLOW_ENABLED=false
POLITICIAN_FOLLOW_ENABLED=false

# Métricas desligadas por padrão. true habilita apenas após consentimento opt-in.
ANALYTICS_ENABLED=false

# Identidade civil/jurídica pública real do controlador: preencher antes do deploy.
# Nunca use nome de teste, exemplo ou apenas a marca.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=privacidade@fpolitico.com.br
