# Ambiente: dev, test, staging, prod
APP_NAME=Farol Político API
APP_VERSION=0.1.0
APP_ENV=dev
DEBUG=true

# Banco de dados
# Dev: SQLite local
DATABASE_URL=sqlite:///./voting_advice.db
# Prod: Postgres (exemplo Railway)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db

# Caminho para arquivos de dados estáticos (propostas, teses)
DATA_DIR=../data

# Origens permitidas no CORS, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Modo de moderacao: enforce (padrao) exige GROQ_API_KEY para posts e comentarios.
# Sem chave ou com falha no provedor, a escrita retorna 503.
# Em desenvolvimento, disabled aprova tudo sem chamar o modelo.
MODERATION_MODE=disabled

# Groq API — obter em https://console.groq.com
GROQ_API_KEY=

# Hardware IoT (desativado por padrão)
IOT_FEATURE_ENABLED=false

# Integracoes historicas de IoT; nao usadas pelo feed oficial /news/weekly
GNEWS_API_KEY=

# Broker MQTT público HiveMQ (dormante com IOT_FEATURE_ENABLED=false)
MQTT_BROKER_URL=mqtts://broker.hivemq.com:8883
